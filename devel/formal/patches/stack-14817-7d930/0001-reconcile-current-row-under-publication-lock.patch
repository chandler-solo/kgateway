+// syncXdsEvents treats KRT events as key notifications, not publishable builds.
+// An event may have waited while admission replayed a newer row on a new
+// connection. Read the authoritative row under the publication lock so neither
+// an old update nor an old delete can undo that replay. Keep the lookup and
+// publication in one critical section: looking up before taking the lock would
+// allow two callbacks to select in one order and publish in the opposite order.
+func (t ProxyTranslator) syncXdsEvents(
+	ctx context.Context,
+	events []krt.Event[XdsSnapWrapper],
+	currentRow func(string) *XdsSnapWrapper,
+	connected func(string) bool,
+) {
+	for _, event := range events {
+		key := event.Latest().ResourceName()
+		func() {
+			t.gate.mu.Lock()
+			defer t.gate.mu.Unlock()
+			if row := currentRow(key); row != nil {
+				t.syncXdsLocked(ctx, *row)
+			} else if connected(key) {
+				// A live client's row was withdrawn. Keep its cache entry and
+				// connection state, but cancel timers for the missing row.
+				t.gate.withdrawLocked(key)
+			} else {
+				t.gate.clientDepartedLocked(key)
+			}
+		}()
+		cd := getDetailsFromXDSClientResourceName(key)
+		kmetrics.EndResourceXDSSync(kmetrics.ResourceSyncDetails{
+			Namespace:    cd.Namespace,
+			Gateway:      cd.Gateway,
+			ResourceName: cd.Gateway,
+		})
+	}
 }
 
