+// An update queued before withdrawal must not resurrect the missing row.
+func TestQueuedSnapshotUpdateObservesWithdrawal(t *testing.T) {
+	f := newConnectionStartFixture(t)
+	f.connect(t, 1)
+	old := f.build("queued-old")
+	f.translator.syncXdsEvents(t.Context(), []krt.Event[XdsSnapWrapper]{{New: &old, Event: controllers.EventAdd}},
+		func(string) *XdsSnapWrapper { return nil }, func(string) bool { return true })
+	_, installed := f.served()
+	require.False(t, installed, "the queued payload is not a current row")
+	f.translator.gate.mu.Lock()
+	pending := f.translator.gate.pending[f.role]
+	f.translator.gate.mu.Unlock()
+	require.Nil(t, pending, "withdrawn rows must not arm a first-publish timer")
+}
+
+// A delayed delete must reconcile the row that has since returned. In
+// particular it must not cancel that row's only bounded first-publish timer.
+func TestQueuedSnapshotDeleteObservesRecreatedRow(t *testing.T) {
+	f := newConnectionStartFixture(t)
+	f.connect(t, 1)
+	old := f.build("deleted")
+	current := f.build("recreated-deferred")
+	current.missingReferenced = []string{"not-ready"}
+	f.current.Store(&current)
+	f.translator.syncXds(t.Context(), current)
+	f.translator.syncXdsEvents(t.Context(), []krt.Event[XdsSnapWrapper]{{Old: &old, Event: controllers.EventDelete}},
+		func(string) *XdsSnapWrapper { return f.current.Load() }, func(string) bool { return true })
+	f.translator.gate.mu.Lock()
+	pending := f.translator.gate.pending[f.role]
+	f.translator.gate.mu.Unlock()
+	require.NotNil(t, pending, "the current deferred row must retain a bounded publish")
+}
+
+// A row selected before a second callback starts cannot publish after that
+// callback. This also covers a later refactor accidentally moving GetKey
+// outside the gate lock while still ignoring the event payload.
+func TestSnapshotLookupAndPublicationAreSerialized(t *testing.T) {
+	f := newConnectionStartFixture(t)
+	f.connect(t, 1)
+	old, current := f.build("old"), f.build("current")
+	selected, resume := make(chan struct{}), make(chan struct{})
+	var release sync.Once
+	t.Cleanup(func() { release.Do(func() { close(resume) }) })
+	firstDone := make(chan struct{})
+	go func() {
+		defer close(firstDone)
+		f.translator.syncXdsEvents(t.Context(), []krt.Event[XdsSnapWrapper]{{New: &old, Event: controllers.EventAdd}},
+			func(string) *XdsSnapWrapper { close(selected); <-resume; return &old }, func(string) bool { return true })
+	}()
+	select {
+	case <-selected:
+	case <-time.After(2 * time.Second):
+		t.Fatal("first callback did not select its row")
+	}
+	secondDone := make(chan struct{})
+	go func() {
+		defer close(secondDone)
+		f.translator.syncXdsEvents(t.Context(), []krt.Event[XdsSnapWrapper]{{New: &current, Event: controllers.EventUpdate}},
+			func(string) *XdsSnapWrapper { return &current }, func(string) bool { return true })
+	}()
+	select {
+	case <-secondDone:
+		t.Error("a later selection overtook the first publication")
+	case <-time.After(100 * time.Millisecond):
+	}
+	release.Do(func() { close(resume) })
+	select {
+	case <-firstDone:
+	case <-time.After(2 * time.Second):
+		t.Fatal("first callback did not finish")
+	}
+	select {
+	case <-secondDone:
+	case <-time.After(2 * time.Second):
+		t.Fatal("second callback did not finish")
+	}
+	version, installed := f.served()
+	require.True(t, installed)
+	require.Equal(t, "current", version, "publication must preserve selection order")
+}
